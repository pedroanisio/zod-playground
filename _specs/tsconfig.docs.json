{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "../_specs/schemas/**/*.ts",
    "../_specs/scripts/**/*.ts"
  ]
}
